# ============================================================================
# PulseRemind / Cue — Environment Configuration Template (.env.example)
# ============================================================================
# Zero-Setup Local-First Default:
# When external credentials are omitted, PulseRemind runs completely hermetic:
# - Embedded Database: `node:sqlite` in WAL mode (stored at PULSEREMIND_DB_PATH)
# - Cache: In-memory L1 LRU with ETag 304 deduplication
# - Notifications: In-app dashboard preview & stdout logging (no external mailer required)
# ============================================================================

# --- Core Server Runtime ---
PORT=3456
NODE_ENV=development

# --- Storage Engine ---
# Options: 'sqlite' (default, zero-setup) or 'supabase' (hosted PostgreSQL)
STORAGE_PROVIDER=sqlite
PULSEREMIND_DB_PATH=./data/pulseremind.db

# --- Cloud Database (Optional: Enable only if STORAGE_PROVIDER=supabase) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Outbound Email Delivery (Optional) ---
# If omitted, notifications are simulated and stored for in-app preview
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=PulseRemind Alerts <notifications@yourdomain.com>

# --- W3C Web Push / VAPID (Optional) ---
# VAPID_PUBLIC_KEY=your_vapid_public_key_base64
# VAPID_PRIVATE_KEY=your_vapid_private_key_base64
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- Instant Mobile Push via ntfy.sh (Optional) ---
# NTFY_TOPIC=pulseremind-notifications-mydevice

# --- Distributed Scrape Cache & Rate Limiting (Optional) ---
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Headless Browser Rendering for Heavy SPAs (Optional) ---
# FIRECRAWL_API_KEY=fc-your-api-key

# --- Security & Anti-Leak Filtering ---
# Comma-separated list of ambient emails to reject from automatic LLM binding
DISALLOWED_AMBIENT_EMAILS=student@university.edu,developer@example.com,ambient-developer@example.com

# --- Resolution Engine Timers ---
SCHEDULER_INTERVAL_MS=60000
ORACLE_CACHE_TTL_MS=120000
ORACLE_RATE_PACE_MS=300
ORACLE_HTTP_TIMEOUT_MS=12000
