# ============================================================================
# PulseRemind — Dual-Mode Infrastructure Configuration (.env.example)
# ============================================================================
# By default, PulseRemind runs in Zero-Setup Embedded Mode (`node:sqlite` + L1 Cache).
# Uncomment any of the third-party cloud providers below to enable Cloud Hybrid Mode.

PORT=3456
PULSEREMIND_DB_PATH=./data/pulseremind.db
DEFAULT_RECIPIENT_EMAIL=

# ----------------------------------------------------------------------------
# 1. Managed Cloud Database (Choose Supabase PostgreSQL OR Turso libSQL)
# ----------------------------------------------------------------------------
# STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_placeholder

# STORAGE_PROVIDER=turso
# TURSO_DATABASE_URL=https://your-db-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSI...

# ----------------------------------------------------------------------------
# 2. Distributed L2 Scrape Cache & Rate Limiter (Upstash Redis REST API)
# ----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...

# ----------------------------------------------------------------------------
# 3. Managed Headless JS Browser Scraper (Firecrawl API for SPA portals)
# ----------------------------------------------------------------------------
# FIRECRAWL_API_KEY=fc-...

# ----------------------------------------------------------------------------
# 4. Managed Transactional Email (Resend or SendGrid)
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
